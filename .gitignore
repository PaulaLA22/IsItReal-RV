# Visual Studio 2015 user specific files
.vs/

# Ignore project apks
Package/Android_ASTC/*

# Ignore Video
Video/*.mp4

# Ignore sound files
Project/Content/IsItReal/Assets/Music/*.wav
Project/Content/IsItReal/Assets/Music/*.mp3

# These project files can be generated by the engine
Project/*.sln

# Binary Files
Project/Binaries/*

# Builds
Project/Build/*

# Configuration files generated by the Editor
Project/Saved/*

# Compiled source files for the engine to use
Project/Intermediate/*

# Cache files for the editor to use
Project/DerivedDataCache/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Project/Build/*/
Project/Build/*/**
!Project/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Project/Build/**/*.ico

# Built data for maps
Project/*_BuiltData.uasset

